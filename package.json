{
  "name": "israel-election-results",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive locality-level results from Israeli Knesset elections 21–25.",
  "homepage": "https://israel-election-results.darthvictor.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarthVictor/israel-election-results.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/check-file-length.mjs",
    "format": "biome format . --check",
    "format:write": "biome format . --write",
    "data:build": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/data/build.ts",
    "data:validate": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/data/build.ts --validate-only",
    "data:translations": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/data/fetch-party-translations.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "leaflet": "^1.9.4",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/topojson-specification": "^1.0.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.0",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
