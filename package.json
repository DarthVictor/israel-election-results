{
  "name": "israel-election-results-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "bundle:report": "node scripts/report-bundle-size.mjs",
    "release:check": "node scripts/release-check.mjs",
    "assets:build": "node scripts/generate-brand-assets.mjs",
    "data:build": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/data/build.ts",
    "data:validate": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/data/build.ts --validate-only",
    "data:test": "vitest run scripts/data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.0",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
